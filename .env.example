# Lokal kopieren nach .env. Auf Render unter Environment Variables eintragen.
# Niemals OPENAI_API_KEY in GitHub, index.html oder Browser-JavaScript speichern.
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_EVALUATION_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_VOICE=marin
APP_VERSION=1.0.0-render
# Optional: zusätzliche erlaubte Frontend-Ursprünge, Komma-getrennt.
# ALLOWED_ORIGINS=https://example.com
